{
  "name": "@jbr-experiment/largerdfbench",
  "version": "6.5.0",
  "description": "LargeRDFBench experiment handler for JBR",
  "main": "index.js",
  "typings": "index",
  "lsd:module": true,
  "author": "Ruben Taelman <rubensworks@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rubensworks/jbr.js.git",
    "directory": "packages/experiment-largerdfbench"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/rubensworks/jbr.js/issues"
  },
  "homepage": "https://github.com/rubensworks/jbr.js#readme",
  "license": "MIT",
  "keywords": [
    "experiment",
    "largerdfbench",
    "fedbench",
    "federation",
    "jbr",
    "benchmarking"
  ],
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/templates",
    "index.d.ts",
    "index.ts",
    "components"
  ],
  "jest": {
    "globals": {
      "ts-jest": {
        "tsconfig": "../../tsconfig.json"
      }
    },
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "collectCoverage": true
  },
  "scripts": {
    "test": "node \"../../node_modules/jest/bin/jest.js\" ${1}",
    "test-watch": "node \"../../node_modules/jest/bin/jest.js\" ${1} --watch",
    "build": "node \"../../node_modules/typescript/bin/tsc\"",
    "validate": "npm ls"
  },
  "devDependencies": {
    "@types/yazl": "^3.3.1",
    "jbr": "^6.2.0",
    "yazl": "^3.3.1"
  },
  "peerDependencies": {
    "jbr": ">=2.0.0"
  },
  "dependencies": {
    "@comunica/query-sparql-rdfjs": "^5.4.1",
    "@rdfjs/types": "*",
    "@types/fs-extra": "^11.0.0",
    "@types/n3": "^1.26.1",
    "@types/sparqljs": "^3.1.12",
    "@types/yauzl": "^3.4.0",
    "fs-extra": "^11.0.0",
    "n3": "^1.26.0",
    "rdf-stores": "^2.10.0",
    "sparql-benchmark-runner": "^5.3.0",
    "sparqljs": "^3.7.0",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "@comunica/query-sparql-hdt": "^5.0.1",
    "hdt": "^3.3.2"
  }
}
