# Friends and friends of friends that have been to given countries
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/data/>
PREFIX snvoc: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX sntag: <http://www.ldbc.eu/ldbc_socialnet/1.0/tag/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dbpedia: <http://dbpedia.org/resource/>
PREFIX dbpedia-owl: <http://dbpedia.org/ontology/>

SELECT
    ?personId
    ?personFirstName
    ?personLastName
    ?xCount
    ?yCount
    (?xCount + ?yCount AS ?count)
WHERE
{
    {
        SELECT
            ?fr
            (SUM(?isX) AS ?xCount)
            (SUM(?isY) AS ?yCount)
        WHERE
        {
            {
                ?countryX foaf:name ?countryXName .
                ?countryX a dbpedia-owl:Country .
                ?message snvoc:isLocatedIn ?countryX .
                BIND( 1 AS ?isX )
                BIND( 0 AS ?isY )
            } UNION {
                ?countryY foaf:name ?countryYName .
                ?countryY a dbpedia-owl:Country .
                ?message snvoc:isLocatedIn ?countryY .
                BIND( 0 AS ?isX )
                BIND( 1 AS ?isY )
            }
            ?message snvoc:creationDate ?creationDate .
            FILTER( ?creationDate >= ?startDate && ?creationDate < ?startDate + STRDT(CONCAT("P", ?durationDays, "D"), xsd:dayTimeDuration) )
            ?message snvoc:hasCreator ?fr .
            {
                SELECT DISTINCT
                    ?fr
                WHERE
                {
                    {
                        ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
                    } UNION {
                        ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson))/((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
                    }
                    FILTER( ?fr != ?rootPerson )
                }
            }
            ?fr snvoc:isLocatedIn ?frCity .
            ?frCity snvoc:isPartOf ?frCountry .
            ?frCountry foaf:name ?frCountryName .
            FILTER( ?frCountryName != ?countryXName && ?frCountryName != ?countryYName )
        }
        GROUP BY ?fr
    }
    FILTER( ?xCount > 0 && ?yCount > 0 )
    ?fr snvoc:id ?personId .
    ?fr snvoc:firstName ?personFirstName .
    ?fr snvoc:lastName ?personLastName .
}
ORDER BY DESC(?xCount) ?personId
LIMIT 20
