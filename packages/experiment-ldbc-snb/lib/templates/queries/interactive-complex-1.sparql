# Transitive friends with certain name
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/data/>
PREFIX snvoc: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX sntag: <http://www.ldbc.eu/ldbc_socialnet/1.0/tag/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dbpedia: <http://dbpedia.org/resource/>
PREFIX dbpedia-owl: <http://dbpedia.org/ontology/>

SELECT
    ?friendId
    ?friendLastName
    ?distanceFromPerson
    ?friendBirthday
    ?friendCreationDate
    ?friendGender
    ?friendBrowserUsed
    ?friendLocationIp
    ?friendEmails
    ?friendLanguages
    ?friendCityName
    ?friendUniversities
    ?friendCompanies
WHERE
{
    {
        SELECT
            ?fr
            (MIN(?dist) AS ?distanceFromPerson)
        WHERE
        {
            {
                ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
                BIND( 1 AS ?dist )
            } UNION {
                ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson))/((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
                BIND( 2 AS ?dist )
            } UNION {
                ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson))/((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson))/((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
                BIND( 3 AS ?dist )
            }
            ?fr snvoc:firstName ?firstName .
            FILTER( ?fr != ?rootPerson )
        }
        GROUP BY ?fr
    }
    ?fr snvoc:id ?friendId .
    ?fr snvoc:lastName ?friendLastName .
    ?fr snvoc:birthday ?friendBirthday .
    ?fr snvoc:creationDate ?friendCreationDate .
    ?fr snvoc:gender ?friendGender .
    ?fr snvoc:browserUsed ?friendBrowserUsed .
    ?fr snvoc:locationIP ?friendLocationIp .
    ?fr snvoc:isLocatedIn ?city .
    ?city foaf:name ?friendCityName .
    OPTIONAL {
        SELECT
            ?fr
            (GROUP_CONCAT(?email; separator=", ") AS ?friendEmails)
        WHERE
        {
            ?fr snvoc:email ?email .
        }
        GROUP BY ?fr
    }
    OPTIONAL {
        SELECT
            ?fr
            (GROUP_CONCAT(?language; separator=", ") AS ?friendLanguages)
        WHERE
        {
            ?fr snvoc:speaks ?language .
        }
        GROUP BY ?fr
    }
    OPTIONAL {
        SELECT
            ?fr
            (GROUP_CONCAT(CONCAT(?uniName, " ", STR(?classYear), " ", ?uniCityName); separator=", ") AS ?friendUniversities)
        WHERE
        {
            ?fr snvoc:studyAt ?study .
            ?study snvoc:hasOrganisation ?uni .
            ?study snvoc:classYear ?classYear .
            ?uni foaf:name ?uniName .
            ?uni snvoc:isLocatedIn/foaf:name ?uniCityName .
        }
        GROUP BY ?fr
    }
    OPTIONAL {
        SELECT
            ?fr
            (GROUP_CONCAT(CONCAT(?companyName, " ", STR(?workFrom), " ", ?companyCountryName); separator=", ") AS ?friendCompanies)
        WHERE
        {
            ?fr snvoc:workAt ?work .
            ?work snvoc:hasOrganisation ?company .
            ?work snvoc:workFrom ?workFrom .
            ?company foaf:name ?companyName .
            ?company snvoc:isLocatedIn/foaf:name ?companyCountryName .
        }
        GROUP BY ?fr
    }
}
ORDER BY ?distanceFromPerson ?friendLastName ?friendId
LIMIT 20
