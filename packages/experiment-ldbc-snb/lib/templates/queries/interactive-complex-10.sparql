# Friend recommendation
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/data/>
PREFIX snvoc: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX sntag: <http://www.ldbc.eu/ldbc_socialnet/1.0/tag/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dbpedia: <http://dbpedia.org/resource/>
PREFIX dbpedia-owl: <http://dbpedia.org/ontology/>

SELECT
    ?personId
    ?personFirstName
    ?personLastName
    ((2 * COUNT(DISTINCT ?commonPost)) - COUNT(DISTINCT ?post) AS ?commonInterestScore)
    ?personGender
    ?personCityName
WHERE
{
    BIND( IF(?month = 12, 1, ?month + 1) AS ?nextMonth )
    {
        SELECT DISTINCT
            ?fr
        WHERE
        {
            ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson))/((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
            FILTER( ?fr != ?rootPerson )
            FILTER NOT EXISTS {
                ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
            }
        }
    }
    ?fr snvoc:id ?personId .
    ?fr snvoc:firstName ?personFirstName .
    ?fr snvoc:lastName ?personLastName .
    ?fr snvoc:gender ?personGender .
    ?fr snvoc:birthday ?birthday .
    ?fr snvoc:isLocatedIn ?city .
    ?city foaf:name ?personCityName .
    FILTER( (MONTH(?birthday) = ?month && DAY(?birthday) >= 21) || (MONTH(?birthday) = ?nextMonth && DAY(?birthday) < 22) )
    OPTIONAL {
        ?post snvoc:hasCreator ?fr .
        ?post a snvoc:Post .
        OPTIONAL {
            ?post snvoc:hasTag ?commonTag .
            ?rootPerson snvoc:hasInterest ?commonTag .
            BIND( ?post AS ?commonPost )
        }
    }
}
GROUP BY ?fr ?personId ?personFirstName ?personLastName ?personGender ?personCityName
ORDER BY DESC(?commonInterestScore) ?personId
LIMIT 10
