# Recent messages by friends or friends of friends
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/data/>
PREFIX snvoc: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX sntag: <http://www.ldbc.eu/ldbc_socialnet/1.0/tag/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dbpedia: <http://dbpedia.org/resource/>
PREFIX dbpedia-owl: <http://dbpedia.org/ontology/>

SELECT
    ?personId
    ?personFirstName
    ?personLastName
    ?messageId
    ?messageContent
    ?messageCreationDate
WHERE
{
    {
        SELECT
            ?fr
            ?message
            ?messageId
            ?messageCreationDate
        WHERE
        {
            {
                SELECT DISTINCT
                    ?fr
                WHERE
                {
                    {
                        ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
                    } UNION {
                        ?rootPerson ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson))/((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?fr .
                    }
                    FILTER( ?fr != ?rootPerson )
                }
            }
            ?message snvoc:hasCreator ?fr .
            ?message snvoc:creationDate ?messageCreationDate .
            FILTER( ?messageCreationDate < ?maxDate )
            ?message snvoc:id ?messageId .
        }
        ORDER BY DESC(?messageCreationDate) ?messageId
        LIMIT 20
    }
    ?message snvoc:content|snvoc:imageFile ?messageContent .
    ?fr snvoc:id ?personId .
    ?fr snvoc:firstName ?personFirstName .
    ?fr snvoc:lastName ?personLastName .
}
ORDER BY DESC(?messageCreationDate) ?messageId
